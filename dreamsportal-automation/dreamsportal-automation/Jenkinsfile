pipeline {

    agent any

    tools {
        maven 'Maven-3.9.16'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out DreamsPortal source code...'
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                echo 'Checking Java, Maven and Node.js versions...'

                bat 'java -version'
                bat 'mvn -version'
                bat 'node --version'
                bat 'npm --version'
            }
        }

        stage('Start Backend Services') {
            steps {
                echo 'Starting DreamsPortal backend services...'

                bat '''
                    start "Dream Service" cmd /c "cd backend\\dream-service && npm install && npm start"
                    start "Summary Service" cmd /c "cd backend\\summary-service && npm install && npm start"
                    start "API Gateway" cmd /c "cd backend\\api-gateway && npm install && npm start"
                '''

                echo 'Waiting for backend services to start...'

                sleep time: 15, unit: 'SECONDS'
            }
        }

        stage('Run Automation Tests') {
            steps {
                echo 'Running DreamsPortal Selenium, API and Database tests...'

                dir('dreamsportal-automation/dreamsportal-automation') {
                    bat 'mvn clean test'
                }
            }
        }
    }

    post {

        always {
            echo 'Publishing test reports...'

            junit allowEmptyResults: true,
                  testResults: 'dreamsportal-automation/dreamsportal-automation/target/surefire-reports/*.xml'

            archiveArtifacts allowEmptyArchive: true,
                             artifacts: 'dreamsportal-automation/dreamsportal-automation/target/surefire-reports/**/*'
        }

        success {
            echo 'DreamsPortal automation tests completed successfully!'
        }

        failure {
            echo 'DreamsPortal automation tests failed. Check the test reports.'
        }
    }
}